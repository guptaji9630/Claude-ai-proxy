# Anthropic Claude API key
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# NVIDIA NIM API key
NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxx

# Server configuration
PORT=3000
NODE_ENV=development

# Optional: NIM API endpoint (defaults to https://integrate.api.nvidia.com)
# NIM_API_BASE_URL=https://integrate.api.nvidia.com

# Optional: Claude API endpoint (defaults to https://api.anthropic.com)
# CLAUDE_API_BASE_URL=https://api.anthropic.com
